{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/drizzle/meta", "!apps/api/src/db/schema/auth.ts", "!apps/web/src/routeTree.gen.ts"]
  },
  "formatter": { "enabled": false },
  // Tailwind's @theme/@apply/@custom-variant are not plain CSS.
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // `row!` after INSERT ... RETURNING and in tests is the deliberate style here.
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
