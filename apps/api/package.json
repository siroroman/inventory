{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "auth generate --config src/auth/auth.cli.ts --output src/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@inventory/shared": "workspace:*",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.10",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
