# Local development defaults matching docker-compose.yml. Copy to apps/api/.env.
# Owner role: runs migrations (DDL).
MIGRATION_DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
# Runtime role (member of app_runtime): used by the API. No DDL, no hard deletes.
DATABASE_URL=postgres://inventory_app:inventory_app@localhost:5432/inventory
# Password of the seeded dev users (admin@, write@, read@example.test). `pnpm db:seed` only; never used in production.
SEED_USER_PASSWORD=dev-heslo-2026
# API (`pnpm --filter api dev`). Public origin of the app: the only origin allowed to call the API with cookies.
# In production this is the app's https URL; with the Vite dev server it will be http://localhost:5173.
BETTER_AUTH_URL=http://localhost:8080
# Signs the session cookie. At least 32 characters; generate one with `openssl rand -base64 32`. Dev value below is not a secret.
BETTER_AUTH_SECRET=dev-only-session-secret-change-me-in-production
# Optional: "Sign in with Google". Both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
